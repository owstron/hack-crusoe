# Copy to .env and fill in. Never commit .env.
# Crusoe Console > Admin > Security > Intelligence API keys
CRUSOE_API_KEY=
# Crusoe OpenAI-compatible base URL
CRUSOE_URL=https://api.inference.crusoecloud.com/v1
# https://you.com/platform
YDC_API_KEY=

# Optional: Meta Marketing API (live mode only; not needed for simulation)
META_ACCESS_TOKEN=
META_PAGE_ID=
META_AD_ACCOUNT_ID=
META_LINK=https://example.com
